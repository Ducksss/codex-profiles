)

package() {
  install -Dm755 "codex-profile-$pkgver" "$pkgdir/usr/bin/codex-profile"
  ln -s codex-profile "$pkgdir/usr/bin/codex-profiles"
  install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
